
// Compute fib using Lazy streams

// fun print_list(xs) {
//   fun e() { print "MT"; }
//   fun c(x,xs) { print x; print_list(xs); }
//   xs()(e,c);
// }

fun sum_list(xs) {
  fun e() { return 0; }
  fun c(x,xs) { return x + sum_list(xs); }
  return xs()(e,c);
}

fun empty() {
  fun k(e,c) {
    return e();
  }
  return k;
}

fun cons(x,xs) {
  fun list() {
    fun k(e,c) { return c(x,xs); }
    return k;
  }
  return list;
}

fun drop(n,xs) {
  if (n <= 0) return xs;
  fun list() {
    fun e() { return empty; }
    fun c(x,xs) { return drop (n-1,xs); }
    return xs()(e,c)();
  }
  return list;
}

fun memo(f) {
  var cache = nil;
  fun g() {
    if (!cache) cache = f();
    return cache;
  }
  return g;
}

fun take(n,xs) {
  if (n <= 0) return empty;
  fun list() {
    fun e() { return empty; }
    fun c(x,xs) {
      return cons (x,take(n-1,xs));
    }
    return xs()(e,c)();
  }
  return memo(list);
}

fun zipWith (f,xs,ys) {
  fun list() {
    fun e() { return empty(); }
    fun c(x,xs) {
      fun e() { return empty(); }
      fun c(y,ys) {
        return cons(f(x,y),zipWith(f,xs,ys))();
      }
      return ys()(e,c);
    }
    return xs()(e,c);
  }
  return memo(list);
}

fun fix(f) {
  var f_fixed = nil;
  fun fixed() { return f_fixed(); }
  f_fixed = f(fixed);
  return fixed;
}

fun test() {
  var A = 0;
  fun add(x,y) { A=A+1; return x+y; }

  fun mkFibs(fibs) {
    return cons (1, cons(1, zipWith(add, fibs, drop(1,fibs))));
  }

  var fibs = fix(mkFibs);

  var res = sum_list(take(1,(drop(30,fibs))));

  if (A != 29) {
    print "unexpected A";
    print A;
  }
  return res;
}


var start = clock();
var sum = 0;
var i = 0;
var rep = 10000;
while (i < rep) {
  var res = test();
  //print res;
  sum = sum + res;
  i = 1+i;
}


if (sum != rep * 1346269) {
  print "unexpected sum";
  print sum;
}

print clock() - start;
